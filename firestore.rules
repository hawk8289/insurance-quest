rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function loggedIn() { return request.auth != null; }
    function roomPath(code) {
      return /databases/$(database)/documents/sessions/$(code);
    }
    function memberPath(code, uid) {
      return /databases/$(database)/documents/sessions/$(code)/participants/$(uid);
    }
    function validAnswerArray(a, n) {
      return a is list && a.size() == n;
    }
    // Enforce all four teams have exactly six members, even if a client
    // tries to upload a malformed assignment map directly.
    function countTeam(groups, team) {
      return groups.size() - groups.removeAll([team]).size();
    }
    function isBalanced24(assignments) {
      let groups = assignments.values();
      return assignments is map
        && assignments.size() == 24
        && groups.hasOnly([0, 1, 2, 3])
        && countTeam(groups, 0) == 6
        && countTeam(groups, 1) == 6
        && countTeam(groups, 2) == 6
        && countTeam(groups, 3) == 6;
    }
    match /sessions/{code} {
      allow read: if loggedIn();
      allow create: if loggedIn()
        && request.resource.data.hostId == request.auth.uid
        && request.resource.data.code == code
        && request.resource.data.status == 'lobby'
        && request.resource.data.joinedCount == 0
        && request.resource.data.maxPlayers == 24
        && request.resource.data.assignments == {};
      allow delete: if false;
      allow update: if loggedIn() && (
        // Only original host may publish grouping.
        (request.auth.uid == resource.data.hostId
          && resource.data.status == 'lobby'
          && request.resource.data.status == 'assigned'
          && request.resource.data.joinedCount == 24
          && isBalanced24(request.resource.data.assignments)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status', 'assignments', 'assignedAt'
          ]))
        ||
        // Atomic join: room count increments exactly once AND this user creates
        // their own participant document as part of the same transaction.
        (resource.data.status == 'lobby'
          && resource.data.joinedCount < resource.data.maxPlayers
          && request.resource.data.joinedCount == resource.data.joinedCount + 1
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['joinedCount'])
          && !exists(memberPath(code, request.auth.uid))
          && getAfter(memberPath(code, request.auth.uid)).data.uid == request.auth.uid
          && getAfter(memberPath(code, request.auth.uid)).data.joinOrder == request.resource.data.joinedCount)
      );

      match /participants/{uid} {
        allow read: if loggedIn();
        allow delete: if false;
        allow create: if loggedIn() && request.auth.uid == uid
          && request.resource.data.uid == uid
          && request.resource.data.nickname is string
          && request.resource.data.nickname.size() > 0
          && request.resource.data.nickname.size() <= 24
          && request.resource.data.submitted == false
          && request.resource.data.answers == []
          && get(roomPath(code)).data.status == 'lobby'
          && getAfter(roomPath(code)).data.joinedCount == get(roomPath(code)).data.joinedCount + 1
          && request.resource.data.joinOrder == getAfter(roomPath(code)).data.joinedCount;
        allow update: if loggedIn()
          && request.auth.uid == uid
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.nickname == resource.data.nickname
          && request.resource.data.joinOrder == resource.data.joinOrder
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'answers','submitted'
          ])
          && get(roomPath(code)).data.status == 'lobby'
          && resource.data.submitted == false
          && request.resource.data.submitted == true
          && validAnswerArray(request.resource.data.answers, 8);
      }
    }
  }
}
